//@version=5
strategy("VWAP Bias Backtest v2 - MNQ", overlay=true, default_qty_type=strategy.fixed, default_qty_value=20, initial_capital=10000, currency=currency.USD, process_orders_on_close=true, use_bar_magnifier=true, commission_type=strategy.commission.cash_per_contract, commission_value=0.62, slippage=4)
// Backtest-only copy of the entry-signal indicator.
// Signals are generated exactly like the live indicator; the TP/SL bracket that
// PickMyTrade places is simulated here so the Strategy Tester can show win rate.
// Signals that arrive while a position is open are ignored (duplicate_position_allow=false)
// but still count toward the daily cap, same as live.

// ===== SIGNAL SETTINGS (keep identical to the live indicator) =====
entryWindowStr    = input.session("0930-1550", "Signals Allowed (NY time)", group="Signal Settings")
maxSignalsPerDay  = input.int(1, "Max Entry Signals Per Day (0 = unlimited)", minval=0, group="Signal Settings")
signalMode        = input.string("VWAP cross", "Send signal on", options=["VWAP cross", "Every bar"], group="Signal Settings")

// ===== PICKMYTRADE BRACKET (keep identical to PickMyTrade) =====
qty         = input.int(20, "Contracts", minval=1, group="PickMyTrade Bracket")
stopTicks   = input.int(20, "Stop Loss (ticks)", minval=1, group="PickMyTrade Bracket")
targetTicks = input.int(80, "Take Profit (ticks)", minval=1, group="PickMyTrade Bracket")
flattenOn   = input.bool(false, "Flatten at end of day", group="PickMyTrade Bracket")
flattenStr  = input.session("1555-1600", "Flatten window (NY time)", group="PickMyTrade Bracket")
simSlip     = input.int(4, "Slippage for stats table (ticks, keep = Properties > Slippage)", minval=0, group="Honest Stats Table")
simComm     = input.float(0.62, "Commission per contract per side (USD)", minval=0, group="Honest Stats Table")

NY_TZ = "America/New_York"

// ===== SESSION / NEW DAY =====
inEntryWindow = not na(time(timeframe.period, entryWindowStr, NY_TZ))
dateId = year(time, NY_TZ) * 10000 + month(time, NY_TZ) * 100 + dayofmonth(time, NY_TZ)
var int prevDateId = na
newDay = na(prevDateId) or dateId != prevDateId
prevDateId := dateId

// ===== VWAP (daily reset) =====
[vwapValue, _u, _l] = ta.vwap(hlc3, newDay, 1)

// ===== SIGNAL LOGIC (same as live indicator) =====
var int signalsToday = 0
var bool firstBarDone = false
if newDay
    signalsToday := 0
    firstBarDone := false

bias      = close > vwapValue ? 1 : close < vwapValue ? -1 : 0
biasFlip  = bias != 0 and bias != nz(bias[1]) and not newDay
trigger   = signalMode == "Every bar" ? bias != 0 : (not firstBarDone and bias != 0) or biasFlip
underCap  = maxSignalsPerDay == 0 or signalsToday < maxSignalsPerDay
sendNow   = inEntryWindow and barstate.isconfirmed and trigger and underCap

longSig  = sendNow and bias == 1
shortSig = sendNow and bias == -1

if inEntryWindow and barstate.isconfirmed and bias != 0
    firstBarDone := true

// ===== HONEST STATS (independent of Bar Magnifier) =====
// Without Bar Magnifier TradingView GUESSES whether TP or SL was hit first when both
// are inside the same bar. This table counts those "ambiguous" trades and shows the
// result both ways: pessimistic (stop first) and optimistic (target first).
// The real result is somewhere between the two.
var int   simDir     = 0
var float simEntry   = na
var int   simTrades  = 0
var int   simWinsP   = 0
var int   simWinsO   = 0
var int   simAmbig   = 0
var float simNetP    = 0.0
var float simNetO    = 0.0
var float simEqP     = 0.0
var float simPeakP   = 0.0
var float simDDP     = 0.0
tickUsd = syminfo.mintick * syminfo.pointvalue
costRT  = 2 * simComm * qty
winUsd  = targetTicks * tickUsd * qty - costRT
lossUsd = -(stopTicks + simSlip) * tickUsd * qty - costRT

if simDir != 0
    slPx  = simEntry - simDir * stopTicks * syminfo.mintick
    tpPx  = simEntry + simDir * targetTicks * syminfo.mintick
    hitSL = simDir == 1 ? low <= slPx : high >= slPx
    hitTP = simDir == 1 ? high >= tpPx : low <= tpPx
    float pP = na
    float pO = na
    if hitSL and hitTP
        simAmbig += 1
        pP := lossUsd
        pO := winUsd
    else if hitSL
        pP := lossUsd
        pO := lossUsd
    else if hitTP
        pP := winUsd
        pO := winUsd
    else if flattenOn and not na(time(timeframe.period, flattenStr, NY_TZ))
        pP := (close - simEntry) * simDir * syminfo.pointvalue * qty - costRT
        pO := pP
    if not na(pP)
        simTrades += 1
        simWinsP  += pP > 0 ? 1 : 0
        simWinsO  += pO > 0 ? 1 : 0
        simNetP   += pP
        simNetO   += pO
        simEqP    += pP
        simPeakP  := math.max(simPeakP, simEqP)
        simDDP    := math.min(simDDP, simEqP - simPeakP)
        simDir    := 0

if (longSig or shortSig) and simDir == 0
    simDir   := longSig ? 1 : -1
    simEntry := close + simDir * simSlip * syminfo.mintick

// ===== SIMULATED PICKMYTRADE EXECUTION =====
if longSig or shortSig
    signalsToday += 1
    if strategy.position_size == 0
        if longSig
            strategy.entry("Long", strategy.long, qty=qty)
            strategy.exit("Long Bracket", from_entry="Long", loss=stopTicks, profit=targetTicks)
        else
            strategy.entry("Short", strategy.short, qty=qty)
            strategy.exit("Short Bracket", from_entry="Short", loss=stopTicks, profit=targetTicks)

if flattenOn and not na(time(timeframe.period, flattenStr, NY_TZ)) and strategy.position_size != 0
    strategy.close_all(comment="EOD Flatten")

// ===== PLOTTING =====
plot(vwapValue, title="VWAP", color=color.new(color.blue, 0), linewidth=2, display=display.pane)
plotshape(longSig,  title="Buy signal",  style=shape.triangleup,   location=location.belowbar, color=color.green, size=size.small, display=display.pane)
plotshape(shortSig, title="Sell signal", style=shape.triangledown, location=location.abovebar, color=color.red,   size=size.small, display=display.pane)

// Stats shown next to the script name on the chart (status line), in this order:
// Trades | Win% pessimistic | Net pessimistic | Net optimistic | Max DD pessimistic | Ambiguous trades
statsDisp = display.status_line + display.data_window
plot(simTrades, "Trades", color=color.gray, display=statsDisp)
plot(simTrades > 0 ? 100.0 * simWinsP / simTrades : na, "Win% (pessimistic)", color=color.orange, display=statsDisp)
plot(simNetP, "Net USD (pessimistic)", color=color.red, display=statsDisp)
plot(simNetO, "Net USD (optimistic)", color=color.green, display=statsDisp)
plot(simDDP, "Max DD USD (pessimistic)", color=color.purple, display=statsDisp)
plot(simAmbig, "Ambiguous trades", color=color.blue, display=statsDisp)

// ===== HONEST STATS TABLE =====
var table st = table.new(position.bottom_left, 3, 6, border_width=1, bgcolor=color.new(color.white, 0), frame_color=color.gray, frame_width=1)
if barstate.islast
    table.cell(st, 0, 0, "", bgcolor=color.gray)
    table.cell(st, 1, 0, "Pessimistic", bgcolor=color.gray, text_color=color.white)
    table.cell(st, 2, 0, "Optimistic", bgcolor=color.gray, text_color=color.white)
    table.cell(st, 0, 1, "Trades")
    table.cell(st, 1, 1, str.tostring(simTrades))
    table.cell(st, 2, 1, str.tostring(simTrades))
    table.cell(st, 0, 2, "Win rate %")
    table.cell(st, 1, 2, simTrades > 0 ? str.tostring(100.0 * simWinsP / simTrades, "#.#") : "-")
    table.cell(st, 2, 2, simTrades > 0 ? str.tostring(100.0 * simWinsO / simTrades, "#.#") : "-")
    table.cell(st, 0, 3, "Net USD")
    table.cell(st, 1, 3, str.tostring(simNetP, "#"), bgcolor = simNetP > 0 ? color.new(color.green, 70) : color.new(color.red, 70))
    table.cell(st, 2, 3, str.tostring(simNetO, "#"), bgcolor = simNetO > 0 ? color.new(color.green, 70) : color.new(color.red, 70))
    table.cell(st, 0, 4, "Max DD USD")
    table.cell(st, 1, 4, str.tostring(simDDP, "#"))
    table.cell(st, 2, 4, "")
    table.cell(st, 0, 5, "Ambiguous bars")
    table.cell(st, 1, 5, str.tostring(simAmbig) + (simTrades > 0 ? " (" + str.tostring(100.0 * simAmbig / simTrades, "#") + "%)" : ""))
    table.cell(st, 2, 5, "")
