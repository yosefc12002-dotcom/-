//@version=5
// אסטרטגיית "הנר הראשון" — נר 5 דקות של פתיחת המסחר בניו יורק (09:30)
// 1. מסמנים High / Low של הנר הראשון (09:30–09:35)
// 2. מחכים לסגירת נר מחוץ לטווח, ואז לנר "ריטסט" שנוגע ברמה אבל סוגר מחוץ לה
// 3. סטופ באמצע הטווח, יעד ביחס 2:1
strategy("First 5-Min Candle – Break & Retest", overlay = true,
     initial_capital = 100000, default_qty_type = strategy.fixed, default_qty_value = 1,
     process_orders_on_close = true, commission_type = strategy.commission.cash_per_contract,
     commission_value = 0)

// ---------- הגדרות ----------
tz        = input.string("America/New_York", "אזור זמן")
rr        = input.float(2.0, "יחס סיכוי:סיכון", minval = 0.5, step = 0.5)
cutoffH   = input.int(12, "שעה אחרונה לכניסה (שעה)", minval = 9, maxval = 16)
cutoffM   = input.int(0,  "שעה אחרונה לכניסה (דקות)", minval = 0, maxval = 59)
flatH     = input.int(15, "סגירת כל הפוזיציות (שעה)", minval = 9, maxval = 23)
flatM     = input.int(55, "סגירת כל הפוזיציות (דקות)", minval = 0, maxval = 59)
allowLong = input.bool(true, "לאפשר לונג")
allowShort= input.bool(true, "לאפשר שורט")

if timeframe.period != "5"
    runtime.error("האסטרטגיה בנויה לגרף של 5 דקות בלבד")

// ---------- זמן ----------
mod      = hour(time, tz) * 60 + minute(time, tz)
newDay   = dayofmonth(time, tz) != dayofmonth(time[1], tz)
isFirst  = mod == 9 * 60 + 30
inWindow = mod >= 9 * 60 + 35 and mod < cutoffH * 60 + cutoffM
flatNow  = mod >= flatH * 60 + flatM

// ---------- מצב ----------
var float orHigh = na
var float orLow  = na
var int   state  = 0        // 1 = נשבר למעלה, -1 = נשבר למטה, 0 = בתוך הטווח
var bool  traded = false

if newDay
    orHigh := na
    orLow  := na
    state  := 0
    traded := false

if isFirst
    orHigh := high
    orLow  := low
    state  := 0
    traded := false

orMid = (orHigh + orLow) / 2

// ---------- כניסה ----------
canTrade = not na(orHigh) and not isFirst and not traded and inWindow and strategy.position_size == 0

if canTrade
    if state == 1
        // ריטסט: נוגע ב-High אבל סוגר מעליו
        if low <= orHigh and close > orHigh
            if allowLong
                risk = close - orMid
                strategy.entry("Long", strategy.long)
                strategy.exit("Long X", "Long", stop = orMid, limit = close + rr * risk)
                traded := true
            state := 0
        else if close <= orHigh
            // פייק-אאוט: חזר לטווח (או שבר את הצד השני)
            state := close < orLow ? -1 : 0
    else if state == -1
        // ריטסט: נוגע ב-Low אבל סוגר מתחתיו
        if high >= orLow and close < orLow
            if allowShort
                risk = orMid - close
                strategy.entry("Short", strategy.short)
                strategy.exit("Short X", "Short", stop = orMid, limit = close - rr * risk)
                traded := true
            state := 0
        else if close >= orLow
            state := close > orHigh ? 1 : 0
    else
        // שלב א': סגירת נר מחוץ לטווח
        if close > orHigh
            state := 1
        else if close < orLow
            state := -1

if flatNow and strategy.position_size != 0
    strategy.close_all(comment = "סוף יום")

// ---------- ציור ----------
plot(isFirst or newDay ? na : orHigh, "High נר ראשון", color.green, 2, plot.style_linebr)
plot(isFirst or newDay ? na : orLow,  "Low נר ראשון",  color.red,   2, plot.style_linebr)
plot(isFirst or newDay ? na : orMid,  "אמצע (סטופ)",   color.gray,  1, plot.style_linebr)
bgcolor(isFirst ? color.new(color.blue, 85) : na, title = "נר ראשון")
