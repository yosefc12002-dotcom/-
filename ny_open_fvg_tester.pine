//@version=6
// NY Open 15m Range -> 5m Breakout (close) -> Return to FVG -> Entry
// Tests 4 variants at once and shows a statistics table:
//   1. Entry at FVG edge,  stop beyond FVG
//   2. Entry at FVG 50%,   stop beyond FVG
//   3. Entry at FVG edge,  stop beyond the displacement candle (candle 2)
//   4. Entry at FVG 50%,   stop beyond the displacement candle (candle 2)
// Use on a 5-minute chart.
indicator("NY Open ORB + FVG Tester", overlay = true, max_boxes_count = 500)

// ---------- Inputs ----------
grpS = "Session (New York time)"
tz        = input.string("America/New_York", "Timezone", group = grpS)
rangeSess = input.session("0930-0945", "Opening range = first 15m candle", group = grpS)
tradeSess = input.session("0945-1200", "Window for breakout & entry", group = grpS)
flatSess  = input.session("1555-1600", "Close everything at", group = grpS)

grpB = "Breakout / FVG"
allowLong   = input.bool(true, "Test longs", group = grpB)
allowShort  = input.bool(true, "Test shorts", group = grpB)
needOverlap = input.bool(false, "FVG must sit on the range line", group = grpB,
     tooltip = "If on, the FVG has to contain the range high (longs) / range low (shorts), like the classic example.")
minFvgTicks = input.int(0, "Minimum FVG size (ticks)", minval = 0, group = grpB)

grpR = "Risk"
bufTicks = input.int(2, "Stop buffer (ticks)", minval = 0, group = grpR)
rr       = input.float(2.0, "R:R target", minval = 0.5, step = 0.25, group = grpR)
tblPos   = input.string("Top right", "Table position", options = ["Top right", "Bottom right", "Top left", "Bottom left"], group = grpR)

N = 4
names = array.from("FVG edge | stop FVG", "FVG 50% | stop FVG", "FVG edge | stop candle 2", "FVG 50% | stop candle 2")

// ---------- Time helpers ----------
inRange = not na(time(timeframe.period, rangeSess, tz))
inTrade = not na(time(timeframe.period, tradeSess, tz))
inFlat  = not na(time(timeframe.period, flatSess, tz))
newDay  = dayofmonth(time, tz) != dayofmonth(time[1], tz)

// ---------- Day state ----------
var float rHi      = na
var float rLo      = na
var int   dir      = 0
var int   brkBar   = na
var bool  fvgFound = false
var bool  dayDead  = false

// per variant: 0 = idle, 1 = limit armed, 2 = in trade, 3 = done for the day
var array<int>   st   = array.new<int>(N, 0)
var array<float> pend = array.new<float>(N, na)
var array<float> sl   = array.new<float>(N, na)
var array<float> tp   = array.new<float>(N, na)

// ---------- Statistics ----------
var int          setups  = 0
var int          fvgDays = 0
var array<int>   fills   = array.new<int>(N, 0)
var array<int>   wins    = array.new<int>(N, 0)
var array<int>   losses  = array.new<int>(N, 0)
var array<float> sumR    = array.new<float>(N, 0.0)
var array<float> sumRL   = array.new<float>(N, 0.0)
var array<float> sumRS   = array.new<float>(N, 0.0)

closeTrade(int i, float r) =>
    sumR.set(i, sumR.get(i) + r)
    if dir == 1
        sumRL.set(i, sumRL.get(i) + r)
    else
        sumRS.set(i, sumRS.get(i) + r)
    if r > 0
        wins.set(i, wins.get(i) + 1)
    else
        losses.set(i, losses.get(i) + 1)
    st.set(i, 3)

if newDay
    rHi      := na
    rLo      := na
    dir      := 0
    brkBar   := na
    fvgFound := false
    dayDead  := false
    for i = 0 to N - 1
        st.set(i, 0)

// 1) Opening range (first 15 minutes, built from 5m bars)
if inRange
    rHi := na(rHi) ? high : math.max(rHi, high)
    rLo := na(rLo) ? low  : math.min(rLo, low)
rangeDone = not na(rHi) and not inRange

// 2) Fills / stops / targets of orders armed on previous bars
if dir != 0
    for i = 0 to N - 1
        s = st.get(i)
        if s == 1
            e = pend.get(i)
            if not inTrade
                st.set(i, 3)                                  // entry window over, cancel
            else if dir == 1 ? low <= e : high >= e
                st.set(i, 2)
                fills.set(i, fills.get(i) + 1)
                if dir == 1 ? low <= sl.get(i) : high >= sl.get(i)
                    closeTrade(i, -1.0)                       // conservative: stop on fill bar = loss
        else if s == 2
            e    = pend.get(i)
            risk = math.abs(e - sl.get(i))
            stopHit = dir == 1 ? low <= sl.get(i) : high >= sl.get(i)
            tpHit   = dir == 1 ? high >= tp.get(i) : low <= tp.get(i)
            if stopHit
                closeTrade(i, -1.0)
            else if tpHit
                closeTrade(i, rr)
            else if inFlat
                closeTrade(i, dir * (close - e) / risk)

// 3) Breakout: a 5m candle CLOSES beyond the 15m range
breakoutBar = false
if rangeDone and inTrade and dir == 0 and not dayDead
    if close > rHi and allowLong
        dir := 1
    else if close < rLo and allowShort
        dir := -1
    if dir != 0
        brkBar      := bar_index
        breakoutBar := true
        setups      += 1

// 4) First FVG created by / after the breakout candle
newFvg = false
float fNear = na
float fFar  = na
if dir != 0 and not fvgFound and not dayDead
    if not inTrade
        dayDead := true
    else if bar_index >= brkBar + 1
        bull = low > high[2]
        bear = high < low[2]
        float c2 = na
        if dir == 1 and bull
            fNear := low          // top of the gap (candle 3 low)
            fFar  := high[2]      // bottom of the gap (candle 1 high)
            c2    := math.min(low[1], fFar)
        else if dir == -1 and bear
            fNear := high         // bottom of the gap (candle 3 high)
            fFar  := low[2]       // top of the gap (candle 1 low)
            c2    := math.max(high[1], fFar)
        if not na(fNear)
            sizeOk    = math.abs(fNear - fFar) >= minFvgTicks * syminfo.mintick
            line      = dir == 1 ? rHi : rLo
            overlapOk = not needOverlap or (line >= math.min(fNear, fFar) and line <= math.max(fNear, fFar))
            if sizeOk and overlapOk
                fvgFound := true
                newFvg   := true
                fvgDays  += 1
                buf = bufTicks * syminfo.mintick
                for i = 0 to N - 1
                    entry = i % 2 == 0 ? fNear : (fNear + fFar) / 2
                    stopB = i < 2 ? fFar : c2
                    stopP = stopB - dir * buf
                    risk  = math.abs(entry - stopP)
                    pend.set(i, entry)
                    sl.set(i, stopP)
                    tp.set(i, entry + dir * risk * rr)
                    st.set(i, 1)
                box.new(bar_index - 2, math.max(fNear, fFar), bar_index + 12, math.min(fNear, fFar),
                     border_color = dir == 1 ? color.green : color.red,
                     bgcolor = color.new(dir == 1 ? color.green : color.red, 80), text = "FVG", text_color = color.white, text_size = size.small)
            else
                fNear := na
                fFar  := na

// ---------- Visuals ----------
bgcolor(inRange ? color.new(color.blue, 85) : na, title = "Opening range bg")
plot(rangeDone ? rHi : na, "Range high", color.green, 2, plot.style_linebr)
plot(rangeDone ? rLo : na, "Range low",  color.red,   2, plot.style_linebr)
showLv = fvgFound and (st.get(0) == 1 or st.get(0) == 2 or st.get(1) == 1 or st.get(1) == 2)
plot(showLv ? pend.get(0) : na, "Entry FVG edge", color.aqua,   1, plot.style_linebr)
plot(showLv ? pend.get(1) : na, "Entry FVG 50%",  color.yellow, 1, plot.style_linebr)
plot(showLv ? sl.get(0)   : na, "Stop FVG",       color.red,    1, plot.style_linebr)
plot(showLv ? tp.get(0)   : na, "Target (edge)",  color.lime,   1, plot.style_linebr)
plotshape(breakoutBar and dir == 1,  "Bull breakout", shape.triangleup,   location.belowbar, color.green, size = size.small)
plotshape(breakoutBar and dir == -1, "Bear breakout", shape.triangledown, location.abovebar, color.red,   size = size.small)

// ---------- Results table ----------
pos = tblPos == "Top right" ? position.top_right : tblPos == "Bottom right" ? position.bottom_right :
      tblPos == "Top left" ? position.top_left : position.bottom_left
var table tbl = table.new(pos, 11, N + 2, bgcolor = color.new(color.black, 15), border_width = 1, border_color = color.gray)

if barstate.islast
    headers = array.from("Variant", "Breakouts", "FVGs", "Fills", "Fill %", "Wins", "Losses", "Win %", "Total R", "R Long", "R Short")
    for c = 0 to 10
        table.cell(tbl, c, 0, headers.get(c), text_color = color.white, bgcolor = color.new(color.blue, 40), text_size = size.small)
    best = 0
    for i = 1 to N - 1
        if sumR.get(i) > sumR.get(best)
            best := i
    for i = 0 to N - 1
        f      = fills.get(i)
        w      = wins.get(i)
        l      = losses.get(i)
        closed = w + l
        fillPct = fvgDays > 0 ? 100.0 * f / fvgDays : 0.0
        winPct  = closed > 0 ? 100.0 * w / closed : 0.0
        rowBg   = i == best and sumR.get(i) > 0 ? color.new(color.green, 60) : na
        tc      = color.white
        r = i + 1
        table.cell(tbl, 0,  r, names.get(i), text_color = tc, bgcolor = rowBg, text_size = size.small)
        table.cell(tbl, 1,  r, str.tostring(setups), text_color = tc, bgcolor = rowBg, text_size = size.small)
        table.cell(tbl, 2,  r, str.tostring(fvgDays), text_color = tc, bgcolor = rowBg, text_size = size.small)
        table.cell(tbl, 3,  r, str.tostring(f), text_color = tc, bgcolor = rowBg, text_size = size.small)
        table.cell(tbl, 4,  r, str.tostring(fillPct, "#.#") + "%", text_color = tc, bgcolor = rowBg, text_size = size.small)
        table.cell(tbl, 5,  r, str.tostring(w), text_color = tc, bgcolor = rowBg, text_size = size.small)
        table.cell(tbl, 6,  r, str.tostring(l), text_color = tc, bgcolor = rowBg, text_size = size.small)
        table.cell(tbl, 7,  r, str.tostring(winPct, "#.#") + "%", text_color = tc, bgcolor = rowBg, text_size = size.small)
        table.cell(tbl, 8,  r, str.tostring(sumR.get(i), "#.##"), text_color = sumR.get(i) >= 0 ? color.lime : color.red, bgcolor = rowBg, text_size = size.small)
        table.cell(tbl, 9,  r, str.tostring(sumRL.get(i), "#.##"), text_color = sumRL.get(i) >= 0 ? color.lime : color.red, bgcolor = rowBg, text_size = size.small)
        table.cell(tbl, 10, r, str.tostring(sumRS.get(i), "#.##"), text_color = sumRS.get(i) >= 0 ? color.lime : color.red, bgcolor = rowBg, text_size = size.small)
    table.cell(tbl, 0, N + 1, "Target 1:" + str.tostring(rr) + " | break-even win rate " + str.tostring(100.0 / (1 + rr), "#.#") + "%",
         text_color = color.silver, text_size = size.tiny)
    table.merge_cells(tbl, 0, N + 1, 10, N + 1)
