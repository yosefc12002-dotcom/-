// Timebased PO3 - 4H Alignment
//
// Three timeframes:
//   - HTF (4H, anchored to fixed NY times 02/06/10/14/18/22) : which 4H cycle we're in, and its
//     developing open/high/low.
//   - FVG detection TF (default 15min)                        : where the "manipulation zone" (an
//     FVG the market is expected to sweep into, as the wick of the 4H candle) is identified.
//   - Entry TF (the chart's own timeframe, 1min or 5min)       : where the sweep into that zone is
//     detected, and where inversion-FVG / BOS-CHoCH confirms the entry.
//
// Logic:
//   1. Flag the 6 fixed 4H opens (02:00/06:00/10:00/14:00/18:00/22:00 NY).
//   2. Only take entries in the window from minute 1 to minute 30 after that open.
//   3. Track the most recent 15min FVG (above open = candidate top wick, below = candidate bottom).
//   4. Wait for entry-TF price to sweep into one of those zones -> that is the 4H candle's wick.
//      Swept into the zone above -> short bias (manipulation up). Swept into the zone below ->
//      long bias (manipulation down).
//   5. Confirm on the entry TF with an inversion FVG and/or a BOS/CHoCH (pivot break), per
//      ENTRY_MODEL, before entering.
//
// Risk: stop beyond the manipulation wick extreme, fixed 1:2 (configurable) R:R target, single
// exit (no partials/runner). One trade per 4H cycle. Daily trade-count and daily-P&L lockouts,
// a named session filter (New York default, Asia/London/custom/all-day), and a "skip first N
// minutes of the session" filter are included.
//
// Webhook automation (e.g. PickMyTrade): this script only manages SSL/TP internally via
// strategy.exit and does not call alert()/alertcondition() with a broker-specific JSON payload,
// because that payload's exact required field names are account/provider-specific. Create ONE
// TradingView alert on this strategy with alert type "Order fills only", and use a message
// template with TradingView's own placeholders, e.g.:
//   {"ticker": "{{ticker}}", "action": "{{strategy.order.action}}",
//    "quantity": "{{strategy.order.contracts}}", "price": "{{close}}", "sl": 0, "tp": 0}
// Verify the exact field names/values PickMyTrade expects in your own PickMyTrade dashboard
// before wiring this to a live broker connection.
//
// This is a strategy specification for backtesting/education, not financial advice. All inputs
// must be calibrated on the target instrument (this version's defaults were tuned for MNQ) before
// any sim/live use.
//
//@version=5
strategy("Timebased PO3 - 4H Alignment", shorttitle = "PO3-4H", overlay = true,
     default_qty_type = strategy.fixed, default_qty_value = 1,
     initial_capital = 50000, currency = currency.USD,
     max_bars_back = 500, max_lines_count = 20, max_labels_count = 20,
     calc_on_every_tick = false)

// ============================================================================
// INPUTS
// ============================================================================
fvgTF                 = input.timeframe("15", "FVG Detection Timeframe", group = "Timeframes")
anchorHoursInput      = input.string("2,6,10,14,18,22", "4H Anchor Hours (NY time, 24h, comma-separated)", group = "Timeframes")
sessionTimezone       = input.string("America/New_York", "Exchange Timezone", group = "Timeframes")
entryWindowMinutes    = input.int(30, "Entry window length after each anchor (minutes)", minval = 1, group = "Timeframes")

manipConfirmModel     = input.string("BOTH_OR", "ENTRY_MODEL (confirmation)", options = ["IFG", "CHOCH", "BOTH_AND", "BOTH_OR"], group = "Entry Confirmation")
requireNConfirmingCloses = input.int(1, "Require N consecutive confirming closes (IFG)", minval = 1, maxval = 5, group = "Entry Confirmation")

fixedRR               = input.float(2.0, "Fixed Risk:Reward (TP = entry +/- RR x risk)", minval = 0.1, step = 0.1, group = "Trade Management")
contractsPerTrade     = input.int(1, "Contracts per trade", minval = 1, group = "Trade Management")

sessionChoice         = input.string("New York", "Trading Session", options = ["New York", "Asia", "London", "All Day", "Custom"], group = "Filters")
customSessionInput    = input.session("0000-2359", "Custom session (used when Trading Session = Custom)", group = "Filters")
skipMinutesAfterOpen  = input.int(0, "Skip first N minutes after session open", minval = 0, group = "Filters")
maxTradesPerDay       = input.int(3, "Max trades per day", minval = 1, group = "Filters")
maxDailyLossUSD       = input.float(500, "Max daily loss lockout ($, 0 = disabled)", minval = 0, group = "Filters")
maxDailyProfitUSD     = input.float(0, "Max daily profit lockout ($, 0 = disabled)", minval = 0, group = "Filters")

showDebugTable        = input.bool(true, "Show state debug table", group = "Display")

// ============================================================================
// SESSION PRESET
// ============================================================================
// "Asia"/"London" windows are expressed in NY time as commonly-cited approximations (DST shifts
// them slightly through the year) -- use "Custom" with your own input.session string for precision.
sessionString = sessionChoice == "New York" ? "0930-1600" :
     sessionChoice == "Asia"   ? "2000-0300" :
     sessionChoice == "London" ? "0300-1130" :
     sessionChoice == "Custom" ? customSessionInput : "0000-2359"

sessionActiveNow  = not na(time(timeframe.period, sessionString, sessionTimezone))
sessionJustOpened = sessionActiveNow and not sessionActiveNow[1]
var int sessionOpenTime = na
if sessionJustOpened
    sessionOpenTime := time
msSinceSessionOpen = na(sessionOpenTime) ? na : time - sessionOpenTime
skipWindowActive   = not na(msSinceSessionOpen) and msSinceSessionOpen < skipMinutesAfterOpen * 60 * 1000
sessionOk = sessionActiveNow and not skipWindowActive

// ============================================================================
// DAILY TRADE COUNT / P&L LOCKOUT
// ============================================================================
dayKey = year(time, sessionTimezone) * 10000 + month(time, sessionTimezone) * 100 + dayofmonth(time, sessionTimezone)
var int   lastDayKey     = na
var int   dayTradeCount  = 0
var float dayStartEquity = na

newDay = na(lastDayKey) or dayKey != lastDayKey
if newDay
    lastDayKey := dayKey
    dayTradeCount := 0
    dayStartEquity := strategy.equity

dayPnl = strategy.equity - dayStartEquity
dailyLossLockout   = maxDailyLossUSD > 0 and dayPnl <= -maxDailyLossUSD
dailyProfitLockout = maxDailyProfitUSD > 0 and dayPnl >= maxDailyProfitUSD
tradeCountLockout  = dayTradeCount >= maxTradesPerDay
dailyOk = not dailyLossLockout and not dailyProfitLockout and not tradeCountLockout

// ============================================================================
// STATE CONSTANTS
// ============================================================================
STATE_WATCH = 0   // within/near the entry window, watching for a 15m FVG zone and a sweep into it
STATE_MANIP = 1   // swept into a zone (the 4H wick) -- watching for IFG/CHoCH confirmation
STATE_DONE  = 2   // already entered this 4H cycle, or the entry window expired

var int   state          = STATE_DONE
var float htfOpen        = na
var float htfHigh        = na
var float htfLow         = na
var int   anchorTime     = na

var float upperZoneHigh  = na
var float upperZoneLow   = na
var float lowerZoneHigh  = na
var float lowerZoneLow   = na

var float sweepExtreme   = na
var int   manipDir       = 0     // +1 = long bias (swept down into the lower zone), -1 = short bias (swept up into the upper zone)

var float fvgLevel        = na
var int   fvgDir          = 0
var int   confirmingCloses = 0

var float lastPivotHigh  = na
var float lastPivotLow   = na

var float primaryTarget  = na
var float stopPrice      = na

var string lastNoTradeReason = ""

// ============================================================================
// 4H ANCHOR DETECTION (fixed NY times, independent of broker HTF bar alignment)
// ============================================================================
var array<int> anchorHours = na
if barstate.isfirst
    anchorHours := array.new<int>()
    anchorParts = str.split(anchorHoursInput, ",")
    for p in anchorParts
        array.push(anchorHours, int(str.tonumber(str.trim(p))))

nyHour   = hour(time, sessionTimezone)
nyMinute = minute(time, sessionTimezone)
isAnchorBar = nyMinute == 0 and array.includes(anchorHours, nyHour)

if isAnchorBar
    anchorTime := time
    htfOpen := open
    htfHigh := high
    htfLow := low
    state := STATE_WATCH
    upperZoneHigh := na
    upperZoneLow := na
    lowerZoneHigh := na
    lowerZoneLow := na
    sweepExtreme := na
    manipDir := 0
    fvgLevel := na
    fvgDir := 0
    confirmingCloses := 0
    lastPivotHigh := na
    lastPivotLow := na
    primaryTarget := na
    stopPrice := na
else
    htfHigh := math.max(htfHigh, high)
    htfLow := math.min(htfLow, low)

msSinceAnchor    = na(anchorTime) ? na : time - anchorTime
windowExpired    = na(msSinceAnchor) or msSinceAnchor > entryWindowMinutes * 60 * 1000
withinEntryWindow = not na(msSinceAnchor) and msSinceAnchor >= 60 * 1000 and not windowExpired

if windowExpired and state != STATE_DONE
    state := STATE_DONE
    lastNoTradeReason := "entry window expired"

// ============================================================================
// 15-MIN FVG ZONE DETECTION (non-repainting: always reads closed FVG-TF bars via [1..3] offsets)
// ============================================================================
h15_c = request.security(syminfo.tickerid, fvgTF, high[1], barmerge.gaps_off, barmerge.lookahead_off)
l15_c = request.security(syminfo.tickerid, fvgTF, low[1],  barmerge.gaps_off, barmerge.lookahead_off)
h15_a = request.security(syminfo.tickerid, fvgTF, high[3], barmerge.gaps_off, barmerge.lookahead_off)
l15_a = request.security(syminfo.tickerid, fvgTF, low[3],  barmerge.gaps_off, barmerge.lookahead_off)
t15_c = request.security(syminfo.tickerid, fvgTF, time[1], barmerge.gaps_off, barmerge.lookahead_off)

new15Bar = ta.change(t15_c) != 0

bullishFvg15 = l15_c > h15_a   // gap zone [h15_a, l15_c], formed on an up leg
bearishFvg15 = h15_c < l15_a   // gap zone [h15_c, l15_a], formed on a down leg

// A bullish gap (C.low > A.high) is, by construction, at or below the current close (price already
// jumped above it) -- it is always a "lower zone" candidate. A bearish gap (C.high < A.low) is
// always at or above the current close -- always an "upper zone" candidate. No need to compare
// against htfOpen: the gap's own definition fixes which side of price it sits on.
if state == STATE_WATCH and new15Bar and not windowExpired
    if bullishFvg15
        lowerZoneHigh := l15_c
        lowerZoneLow  := h15_a
    if bearishFvg15
        upperZoneHigh := l15_a
        upperZoneLow  := h15_c

// ============================================================================
// MANIPULATION: entry-TF price sweeps into a zone -> that is the 4H candle's wick
// ============================================================================
if state == STATE_WATCH and not windowExpired
    sweptUp   = not na(upperZoneLow) and high >= upperZoneLow
    sweptDown = not na(lowerZoneHigh) and low <= lowerZoneHigh
    if sweptUp and not sweptDown
        manipDir := -1
        sweepExtreme := high
        state := STATE_MANIP
    else if sweptDown and not sweptUp
        manipDir := 1
        sweepExtreme := low
        state := STATE_MANIP

// Deeper wick before confirmation: extend the extreme and restart the confirmation search.
if state == STATE_MANIP
    if manipDir == -1 and high > sweepExtreme
        sweepExtreme := high
        fvgLevel := na
        fvgDir := 0
        confirmingCloses := 0
    if manipDir == 1 and low < sweepExtreme
        sweepExtreme := low
        fvgLevel := na
        fvgDir := 0
        confirmingCloses := 0

// ============================================================================
// ENTRY CONFIRMATION: inversion FVG (entry TF) and/or BOS/CHoCH (pivot break)
// ============================================================================
bearishFvgNow = low[2] > high     // C1.low > C3.high (entry-TF 3-bar gap on a down leg)
bullishFvgNow = high[2] < low     // C1.high < C3.low (entry-TF 3-bar gap on an up leg)

if state == STATE_MANIP and na(fvgLevel)
    if manipDir == 1 and bearishFvgNow
        fvgLevel := low[2]
        fvgDir := 1
    else if manipDir == -1 and bullishFvgNow
        fvgLevel := high[2]
        fvgDir := -1

ifgCloseConfirm = false
if state == STATE_MANIP and not na(fvgLevel)
    closesBeyond = (fvgDir == 1 and close > fvgLevel) or (fvgDir == -1 and close < fvgLevel)
    confirmingCloses := closesBeyond ? confirmingCloses + 1 : 0
    ifgCloseConfirm := confirmingCloses >= requireNConfirmingCloses

ph = ta.pivothigh(1, 1)
pl = ta.pivotlow(1, 1)
if state == STATE_MANIP
    if not na(ph)
        lastPivotHigh := ph
    if not na(pl)
        lastPivotLow := pl

chochOk = state == STATE_MANIP and (
     (manipDir == 1 and not na(lastPivotHigh) and close > lastPivotHigh) or
     (manipDir == -1 and not na(lastPivotLow) and close < lastPivotLow))

ifgOk = ifgCloseConfirm
confirmed = manipConfirmModel == "IFG" ? ifgOk :
     manipConfirmModel == "CHOCH" ? chochOk :
     manipConfirmModel == "BOTH_AND" ? (ifgOk and chochOk) : (ifgOk or chochOk)

// ============================================================================
// TRADE EXECUTION
// ============================================================================
if state == STATE_MANIP and confirmed and withinEntryWindow and strategy.position_size == 0
    if not (sessionOk and dailyOk)
        lastNoTradeReason := "session/daily filter blocked entry"
    else if manipDir == 1
        stopLvl = sweepExtreme
        risk    = close - stopLvl
        if risk > 0
            stopPrice := stopLvl
            primaryTarget := close + risk * fixedRR
            strategy.entry("Long", strategy.long, qty = contractsPerTrade)
            strategy.exit("Exit-Long", "Long", limit = primaryTarget, stop = stopPrice)
            dayTradeCount := dayTradeCount + 1
            state := STATE_DONE
    else if manipDir == -1
        stopLvl = sweepExtreme
        risk    = stopLvl - close
        if risk > 0
            stopPrice := stopLvl
            primaryTarget := close - risk * fixedRR
            strategy.entry("Short", strategy.short, qty = contractsPerTrade)
            strategy.exit("Exit-Short", "Short", limit = primaryTarget, stop = stopPrice)
            dayTradeCount := dayTradeCount + 1
            state := STATE_DONE

// ============================================================================
// PLOTTING / VISUALS
// ============================================================================
plot(state != STATE_DONE ? htfOpen : na, "4H Open", color = color.new(color.gray, 20), style = plot.style_circles)

plot(state != STATE_DONE ? upperZoneHigh : na, "Upper FVG Zone High", color = color.new(color.red, 40), style = plot.style_linebr)
plot(state != STATE_DONE ? upperZoneLow  : na, "Upper FVG Zone Low",  color = color.new(color.red, 40), style = plot.style_linebr)
plot(state != STATE_DONE ? lowerZoneHigh : na, "Lower FVG Zone High", color = color.new(color.green, 40), style = plot.style_linebr)
plot(state != STATE_DONE ? lowerZoneLow  : na, "Lower FVG Zone Low",  color = color.new(color.green, 40), style = plot.style_linebr)

bgcolor(withinEntryWindow ? color.new(color.blue, 90) : na, title = "Active entry window")

plotshape(state == STATE_MANIP and manipDir == -1 and sweepExtreme == high, title = "Sweep Up (top wick)",
     style = shape.triangledown, location = location.abovebar, color = color.red, size = size.tiny)
plotshape(state == STATE_MANIP and manipDir == 1 and sweepExtreme == low, title = "Sweep Down (bottom wick)",
     style = shape.triangleup, location = location.belowbar, color = color.green, size = size.tiny)

plotshape(strategy.position_size > 0 and strategy.position_size[1] == 0, title = "Long Entry",
     style = shape.labelup, location = location.belowbar, color = color.green, textcolor = color.white, text = "L")
plotshape(strategy.position_size < 0 and strategy.position_size[1] == 0, title = "Short Entry",
     style = shape.labeldown, location = location.abovebar, color = color.red, textcolor = color.white, text = "S")

alertcondition(strategy.position_size > 0 and strategy.position_size[1] == 0, title = "PO3 Long Entry", message = "PO3 4H long entry confirmed")
alertcondition(strategy.position_size < 0 and strategy.position_size[1] == 0, title = "PO3 Short Entry", message = "PO3 4H short entry confirmed")

if showDebugTable
    var table dbg = table.new(position.top_right, 2, 8, bgcolor = color.new(color.black, 70), border_width = 1)
    stateLabel = state == STATE_WATCH ? "WATCHING" : state == STATE_MANIP ? "MANIPULATION" : "DONE (this 4H cycle)"
    if barstate.islast
        table.cell(dbg, 0, 0, "State", text_color = color.white)
        table.cell(dbg, 1, 0, stateLabel, text_color = color.white)
        table.cell(dbg, 0, 1, "Entry window", text_color = color.white)
        table.cell(dbg, 1, 1, withinEntryWindow ? "OPEN" : windowExpired ? "expired" : "not yet (< 1min)", text_color = color.white)
        table.cell(dbg, 0, 2, "Manip Dir", text_color = color.white)
        table.cell(dbg, 1, 2, manipDir == 1 ? "Long bias" : manipDir == -1 ? "Short bias" : "-", text_color = color.white)
        table.cell(dbg, 0, 3, "Confirm closes", text_color = color.white)
        table.cell(dbg, 1, 3, str.tostring(confirmingCloses), text_color = color.white)
        table.cell(dbg, 0, 4, "Session / Skip", text_color = color.white)
        table.cell(dbg, 1, 4, (sessionOk ? "OK" : "no"), text_color = color.white)
        table.cell(dbg, 0, 5, "Trades today", text_color = color.white)
        table.cell(dbg, 1, 5, str.tostring(dayTradeCount) + " / " + str.tostring(maxTradesPerDay), text_color = color.white)
        table.cell(dbg, 0, 6, "Day P&L", text_color = color.white)
        table.cell(dbg, 1, 6, str.tostring(dayPnl, "#.##"), text_color = color.white)
        table.cell(dbg, 0, 7, "Last no-trade", text_color = color.white)
        table.cell(dbg, 1, 7, lastNoTradeReason, text_color = color.white)
