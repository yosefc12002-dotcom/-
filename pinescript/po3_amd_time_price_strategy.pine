// Timebased PO3 - 4H Alignment (simplified: direct sweep-into-FVG entry, no extra confirmation layer)
//
// Flow:
//   1. Each 4H anchor (fixed NY times, each with its own entry-window length) opens a cycle:
//        02:00 NY (09:00 Israel) -> 120min window   (09:00-11:00 Israel)
//        10:00 NY (17:00 Israel) -> 90min window     (17:00-18:30 Israel)
//        14:00 NY (21:00 Israel) -> 90min window      (21:00-22:30 Israel)
//      Configurable via ANCHOR_CONFIG ("NY_hour:window_minutes" pairs).
//   2. The 4H candle chops (accumulation), then a 15min or 5min FVG forms near the open -- whichever
//      timeframe's gap forms FIRST (closest in time to the open) is locked in as the zone to watch;
//      a bullish gap is always a "lower zone" (sits below price), a bearish gap always an "upper
//      zone" (sits above price), by construction.
//   3. The moment entry-TF price trades into that zone IS the manipulation (the 4H candle's wick)
//      AND the entry trigger, in one step -- no separate inversion-FVG/BOS-CHoCH confirmation layer.
//      Swept into the upper zone -> short. Swept into the lower zone -> long.
//   4. Stop at that bar's extreme, fixed 1:2 (configurable) R:R target, single exit. One trade per
//      4H cycle.
//
// Filters: named session preset (default All Day -- a continuous range like New York's 09:30-1600
// would exclude the 02:00 NY anchor), skip-N-minutes-after-session-open, daily trade-count limit,
// daily loss/profit lockout.
//
// Webhook automation (e.g. PickMyTrade): SL/TP are managed internally via strategy.exit. Create ONE
// TradingView alert on this strategy with alert type "Order fills only" and a message template using
// TradingView's own placeholders, e.g.:
//   {"ticker": "{{ticker}}", "action": "{{strategy.order.action}}",
//    "quantity": "{{strategy.order.contracts}}", "price": "{{close}}", "sl": 0, "tp": 0}
// Verify the exact field names PickMyTrade expects in your own dashboard before going live with it.
//
// This is a strategy specification for backtesting/education, not financial advice. Defaults here
// were tuned for MNQ (Micro Nasdaq). Removing the confirmation layer trades fewer false negatives
// for more false positives -- back-test this version's win rate/expectancy before any sim/live use.
//
//@version=5
strategy("Timebased PO3 - 4H Alignment", shorttitle = "PO3-4H", overlay = true,
     default_qty_type = strategy.fixed, default_qty_value = 1,
     initial_capital = 50000, currency = currency.USD,
     max_bars_back = 500, max_lines_count = 20, max_labels_count = 20,
     calc_on_every_tick = false)

// ============================================================================
// INPUTS
// ============================================================================
anchorConfigInput     = input.string("2:120,10:90,14:90", "4H Anchors: NY_hour:window_minutes (comma-separated) -- defaults = 9-11am/5-6:30pm/9-10:30pm Israel time in summer DST", group = "Timeframes")
sessionTimezone       = input.string("America/New_York", "Exchange Timezone", group = "Timeframes")

fixedRR               = input.float(2.0, "Fixed Risk:Reward (TP = entry +/- RR x risk)", minval = 0.1, step = 0.1, group = "Trade Management")
contractsPerTrade     = input.int(1, "Contracts per trade", minval = 1, group = "Trade Management")

sessionChoice         = input.string("All Day", "Trading Session (leave All Day if your anchor windows already cover your desired times of day -- a continuous range like New York's 09:30-16:00 will exclude the 02:00 NY anchor)", options = ["New York", "Asia", "London", "All Day", "Custom"], group = "Filters")
customSessionInput    = input.session("0000-2359", "Custom session (used when Trading Session = Custom)", group = "Filters")
skipMinutesAfterOpen  = input.int(0, "Skip first N minutes after session open", minval = 0, group = "Filters")
maxTradesPerDay       = input.int(3, "Max trades per day", minval = 1, group = "Filters")
maxDailyLossUSD       = input.float(500, "Max daily loss lockout ($, 0 = disabled)", minval = 0, group = "Filters")
maxDailyProfitUSD     = input.float(0, "Max daily profit lockout ($, 0 = disabled)", minval = 0, group = "Filters")

showDebugTable        = input.bool(true, "Show state debug table", group = "Display")

// ============================================================================
// SESSION PRESET
// ============================================================================
// "Asia"/"London" windows are expressed in NY time as commonly-cited approximations (DST shifts
// them slightly through the year) -- use "Custom" with your own input.session string for precision.
sessionString = sessionChoice == "New York" ? "0930-1600" :
     sessionChoice == "Asia"   ? "2000-0300" :
     sessionChoice == "London" ? "0300-1130" :
     sessionChoice == "Custom" ? customSessionInput : "0000-2359"

sessionActiveNow  = not na(time(timeframe.period, sessionString, sessionTimezone))
sessionJustOpened = sessionActiveNow and not sessionActiveNow[1]
var int sessionOpenTime = na
if sessionJustOpened
    sessionOpenTime := time
msSinceSessionOpen = na(sessionOpenTime) ? na : time - sessionOpenTime
skipWindowActive   = not na(msSinceSessionOpen) and msSinceSessionOpen < skipMinutesAfterOpen * 60 * 1000
sessionOk = sessionActiveNow and not skipWindowActive

// ============================================================================
// DAILY TRADE COUNT / P&L LOCKOUT
// ============================================================================
dayKey = year(time, sessionTimezone) * 10000 + month(time, sessionTimezone) * 100 + dayofmonth(time, sessionTimezone)
var int   lastDayKey     = na
var int   dayTradeCount  = 0
var float dayStartEquity = na

newDay = na(lastDayKey) or dayKey != lastDayKey
if newDay
    lastDayKey := dayKey
    dayTradeCount := 0
    dayStartEquity := strategy.equity

dayPnl = strategy.equity - dayStartEquity
dailyLossLockout   = maxDailyLossUSD > 0 and dayPnl <= -maxDailyLossUSD
dailyProfitLockout = maxDailyProfitUSD > 0 and dayPnl >= maxDailyProfitUSD
tradeCountLockout  = dayTradeCount >= maxTradesPerDay
dailyOk = not dailyLossLockout and not dailyProfitLockout and not tradeCountLockout

// ============================================================================
// STATE
// ============================================================================
STATE_WATCH = 0   // within the entry window, watching for a 5m/15m FVG zone and a sweep into it
STATE_DONE  = 1   // already entered this 4H cycle, or the entry window expired

var int   state              = STATE_DONE
var int   anchorTime         = na
var int   currentWindowMinutes = na

var float upperZoneHigh  = na
var float upperZoneLow   = na
var float lowerZoneHigh  = na
var float lowerZoneLow   = na

var float primaryTarget  = na
var float stopPrice      = na

var string lastNoTradeReason = ""

// ============================================================================
// 4H ANCHOR DETECTION: fixed NY hours, each with its own entry-window length
// ============================================================================
var array<int> anchorHours   = na
var array<int> anchorWindows = na
if barstate.isfirst
    anchorHours := array.new<int>()
    anchorWindows := array.new<int>()
    anchorPairs = str.split(anchorConfigInput, ",")
    for pairStr in anchorPairs
        kv = str.split(str.trim(pairStr), ":")
        array.push(anchorHours, int(str.tonumber(str.trim(array.get(kv, 0)))))
        array.push(anchorWindows, int(str.tonumber(str.trim(array.get(kv, 1)))))

nyHour    = hour(time, sessionTimezone)
nyMinute  = minute(time, sessionTimezone)
anchorIdx = nyMinute == 0 ? array.indexof(anchorHours, nyHour) : -1
isAnchorBar = anchorIdx >= 0

if isAnchorBar
    anchorTime := time
    currentWindowMinutes := array.get(anchorWindows, anchorIdx)
    state := STATE_WATCH
    upperZoneHigh := na
    upperZoneLow := na
    lowerZoneHigh := na
    lowerZoneLow := na
    primaryTarget := na
    stopPrice := na

msSinceAnchor     = na(anchorTime) ? na : time - anchorTime
windowExpired     = na(msSinceAnchor) or msSinceAnchor > currentWindowMinutes * 60 * 1000
withinEntryWindow = not na(msSinceAnchor) and not windowExpired

if windowExpired and state != STATE_DONE
    state := STATE_DONE
    lastNoTradeReason := "entry window expired"

// ============================================================================
// FVG ZONE DETECTION on 15min AND 5min -- first one to form (closest to the open) wins
// (non-repainting: always reads closed HTF-context bars via the [1]/[3] offsets)
// ============================================================================
h15_c = request.security(syminfo.tickerid, "15", high[1], barmerge.gaps_off, barmerge.lookahead_off)
l15_c = request.security(syminfo.tickerid, "15", low[1],  barmerge.gaps_off, barmerge.lookahead_off)
h15_a = request.security(syminfo.tickerid, "15", high[3], barmerge.gaps_off, barmerge.lookahead_off)
l15_a = request.security(syminfo.tickerid, "15", low[3],  barmerge.gaps_off, barmerge.lookahead_off)
t15_c = request.security(syminfo.tickerid, "15", time[1], barmerge.gaps_off, barmerge.lookahead_off)
new15Bar = ta.change(t15_c) != 0
bullishFvg15 = l15_c > h15_a
bearishFvg15 = h15_c < l15_a

h5_c = request.security(syminfo.tickerid, "5", high[1], barmerge.gaps_off, barmerge.lookahead_off)
l5_c = request.security(syminfo.tickerid, "5", low[1],  barmerge.gaps_off, barmerge.lookahead_off)
h5_a = request.security(syminfo.tickerid, "5", high[3], barmerge.gaps_off, barmerge.lookahead_off)
l5_a = request.security(syminfo.tickerid, "5", low[3],  barmerge.gaps_off, barmerge.lookahead_off)
t5_c = request.security(syminfo.tickerid, "5", time[1], barmerge.gaps_off, barmerge.lookahead_off)
new5Bar = ta.change(t5_c) != 0
bullishFvg5 = l5_c > h5_a
bearishFvg5 = h5_c < l5_a

// A bullish gap is, by construction, at or below current price (a "lower zone" candidate,
// swept by a downward move). A bearish gap is always at or above current price (an "upper zone").
// Whichever timeframe's gap completes FIRST after the anchor claims that zone; the other is ignored.
if state == STATE_WATCH and not windowExpired
    if new15Bar
        if bullishFvg15 and na(lowerZoneHigh)
            lowerZoneHigh := l15_c
            lowerZoneLow := h15_a
        if bearishFvg15 and na(upperZoneHigh)
            upperZoneHigh := l15_a
            upperZoneLow := h15_c
    if new5Bar
        if bullishFvg5 and na(lowerZoneHigh)
            lowerZoneHigh := l5_c
            lowerZoneLow := h5_a
        if bearishFvg5 and na(upperZoneHigh)
            upperZoneHigh := l5_a
            upperZoneLow := h5_c

// ============================================================================
// MANIPULATION + ENTRY, IN ONE STEP: the sweep into the zone IS the trigger
// ============================================================================
if state == STATE_WATCH and withinEntryWindow and strategy.position_size == 0
    sweptUp   = not na(upperZoneLow) and high >= upperZoneLow
    sweptDown = not na(lowerZoneHigh) and low <= lowerZoneHigh

    if sweptUp and not sweptDown
        stopLvl = high
        risk = stopLvl - close
        if risk > 0
            if sessionOk and dailyOk
                stopPrice := stopLvl
                primaryTarget := close - risk * fixedRR
                strategy.entry("Short", strategy.short, qty = contractsPerTrade)
                strategy.exit("Exit-Short", "Short", limit = primaryTarget, stop = stopPrice)
                dayTradeCount := dayTradeCount + 1
                state := STATE_DONE
            else
                lastNoTradeReason := "session/daily filter blocked entry"
    else if sweptDown and not sweptUp
        stopLvl = low
        risk = close - stopLvl
        if risk > 0
            if sessionOk and dailyOk
                stopPrice := stopLvl
                primaryTarget := close + risk * fixedRR
                strategy.entry("Long", strategy.long, qty = contractsPerTrade)
                strategy.exit("Exit-Long", "Long", limit = primaryTarget, stop = stopPrice)
                dayTradeCount := dayTradeCount + 1
                state := STATE_DONE
            else
                lastNoTradeReason := "session/daily filter blocked entry"

// ============================================================================
// PLOTTING / VISUALS
// ============================================================================
plot(state != STATE_DONE ? upperZoneHigh : na, "Upper FVG Zone High", color = color.new(color.red, 40), style = plot.style_linebr)
plot(state != STATE_DONE ? upperZoneLow  : na, "Upper FVG Zone Low",  color = color.new(color.red, 40), style = plot.style_linebr)
plot(state != STATE_DONE ? lowerZoneHigh : na, "Lower FVG Zone High", color = color.new(color.green, 40), style = plot.style_linebr)
plot(state != STATE_DONE ? lowerZoneLow  : na, "Lower FVG Zone Low",  color = color.new(color.green, 40), style = plot.style_linebr)

bgcolor(withinEntryWindow ? color.new(color.blue, 90) : na, title = "Active entry window")

plotshape(strategy.position_size > 0 and strategy.position_size[1] == 0, title = "Long Entry",
     style = shape.labelup, location = location.belowbar, color = color.green, textcolor = color.white, text = "L")
plotshape(strategy.position_size < 0 and strategy.position_size[1] == 0, title = "Short Entry",
     style = shape.labeldown, location = location.abovebar, color = color.red, textcolor = color.white, text = "S")

alertcondition(strategy.position_size > 0 and strategy.position_size[1] == 0, title = "PO3 Long Entry", message = "PO3 4H long entry confirmed")
alertcondition(strategy.position_size < 0 and strategy.position_size[1] == 0, title = "PO3 Short Entry", message = "PO3 4H short entry confirmed")

if showDebugTable
    var table dbg = table.new(position.top_right, 2, 6, bgcolor = color.new(color.black, 70), border_width = 1)
    stateLabel = state == STATE_WATCH ? "WATCHING" : "DONE (this 4H cycle)"
    if barstate.islast
        table.cell(dbg, 0, 0, "State", text_color = color.white)
        table.cell(dbg, 1, 0, stateLabel, text_color = color.white)
        table.cell(dbg, 0, 1, "Entry window", text_color = color.white)
        table.cell(dbg, 1, 1, withinEntryWindow ? "OPEN" : "expired/none", text_color = color.white)
        table.cell(dbg, 0, 2, "Session", text_color = color.white)
        table.cell(dbg, 1, 2, sessionOk ? "OK" : "no", text_color = color.white)
        table.cell(dbg, 0, 3, "Trades today", text_color = color.white)
        table.cell(dbg, 1, 3, str.tostring(dayTradeCount) + " / " + str.tostring(maxTradesPerDay), text_color = color.white)
        table.cell(dbg, 0, 4, "Day P&L", text_color = color.white)
        table.cell(dbg, 1, 4, str.tostring(dayPnl, "#.##"), text_color = color.white)
        table.cell(dbg, 0, 5, "Last no-trade", text_color = color.white)
        table.cell(dbg, 1, 5, lastNoTradeReason, text_color = color.white)
