//@version=4
strategy("ORB", overlay = true, default_qty_type = strategy.fixed, default_qty_value = 1, process_orders_on_close = false)

inputMax = input(5, title= "ORB total time (minutes)")
sess = input("0915-0920", type=input.session, title="Session Time")
holdBars = input(3, title="Bars to hold", minval=1)
// ---- Bot / webhook settings (sent with every order via {{strategy.order.alert_message}})
botQty = input(1, title="Bot: Quantity", minval=1)
botKey = input("YOUR_SECRET", title="Bot: Webhook passphrase")
t = time(timeframe.period, sess + ":1234567")
hide = timeframe.isintraday and timeframe.multiplier <= inputMax

is_newbar(res) => change(time(res)) != 0
in_session = not na(t)
is_first = in_session and not in_session[1]

orb_high = float(na)
orb_low = float(na)

if is_first
    orb_high := high
    orb_low := low
else
    orb_high := orb_high[1]
    orb_low := orb_low[1]
if high > orb_high and in_session
    orb_high := high
if low < orb_low and in_session
    orb_low := low

plot(hide ? orb_high : na , style=plot.style_line, color=orb_high[1] != orb_high ? na : color.green, title="ORB High", linewidth=2)
plot(hide ? orb_low : na , style=plot.style_line, color=orb_low[1] != orb_low ? na : color.red, title="ORB Low", linewidth=2)

// ---- Signals: bar closes across the range (only after the ORB session is over)
range_ready = hide and not in_session and not na(orb_high) and not na(orb_low)
long_signal = range_ready and crossover(close, orb_high)
short_signal = range_ready and crossunder(close, orb_low)

plotshape(long_signal, style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, title="Long Signal")
plotshape(short_signal, style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, title="Short Signal")

// ---- Bot alert payloads (JSON for a webhook: 3Commas / PineConnector / your own server, etc.)
msg(action) =>
    '{"passphrase":"' + botKey + '","action":"' + action + '","ticker":"' + syminfo.ticker + '","qty":' + tostring(botQty) + ',"price":' + tostring(close) + ',"time":' + tostring(timenow) + '}'

// ---- Orders: placed on the signal bar's close, filled at the next bar's open, held for holdBars bars
var int entry_bar = na

if long_signal
    strategy.entry("Long", strategy.long, qty=botQty, alert_message=msg("buy"))
    entry_bar := bar_index + 1
if short_signal
    strategy.entry("Short", strategy.short, qty=botQty, alert_message=msg("sell"))
    entry_bar := bar_index + 1

// Exit order placed at the close of the last holding bar -> fills at the open of the following bar
if strategy.position_size != 0 and not na(entry_bar) and bar_index >= entry_bar + holdBars - 1 and not long_signal and not short_signal
    strategy.close_all(comment="Exit after " + tostring(holdBars) + " bars", alert_message=msg("close"))
    entry_bar := na
